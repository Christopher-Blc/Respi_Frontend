{
  "expo": {
    "name": "ResPi",
    "slug": "ResPi",
    "version": "1.0.0",
    "scheme": ["respi-app", "ResPi"],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.respiteam.ResPi",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.respi.app",
      "googleServicesFile": "./google-services.json",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "respi-app",
              "host": "verify-email"
            },
            {
              "scheme": "https",
              "host": "respi.es",
              "pathPrefix": "/verify-email"
            },
            {
              "scheme": "https",
              "host": "www.respi.es",
              "pathPrefix": "/verify-email"
            }
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "display": "standalone",
      "meta": {
        "viewport": "width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover, interactive-widget=resizes-content"
      },
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      "expo-secure-store"
    ],
    "extra": {
      "router": {
        "root": "./src/app"
      },
      "eas": {
        "projectId": "5252a828-417c-473b-83a3-7d93493fbb8e"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/0fda7759-726c-4a3b-a748-28fbbbb1493c"
    },
    "owner": "respiteam"
  }
}
